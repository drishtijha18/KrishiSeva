# Supabase Configuration
# Obtain from your Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key

# JWT Secret Key for token signing and verification
JWT_SECRET=your_super_secret_jwt_key_change_in_production

# Backend Server Port (defaults to 5001)
PORT=5001

# Allowed Frontend URL for CORS (optional in local development)
FRONTEND_URL=http://localhost:5173

# Data.gov.in API Key for Live Mandi Crop Prices
DATA_GOV_API_KEY=your_data_gov_in_api_key
